{
  "name": "sana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:rulepack": "node --import tsx/esm scripts/lint-rulepack.ts || bun scripts/lint-rulepack.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:safety": "vitest run --config vitest.safety.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run lint:rulepack && npm run test:unit && npm run test:safety",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^14.0.2",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.7",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.0.5",
    "pg": "^8.23.0",
    "postcss": "^8.5.2",
    "supabase": "^2.12.0",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
