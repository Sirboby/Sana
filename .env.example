# Sana Environment Variables (PRD §10.2)
# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ─────────── Application (PRD §10.2) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_RULEPACK_MIN_VERSION=
SENTRY_DSN=

# ─────────── Database-backed tests & migrations ───────────
# Hosted project: Project Settings -> API for URL and keys,
#                 Project Settings -> Database -> Connection string (URI) for SUPABASE_DB_URL.
# Local Supabase: run `supabase status` — needs Docker.
#
# Use a DEDICATED dev/test project. The RLS suite deletes and re-inserts rows
# with the service-role key; it must never point at a database holding real users.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Direct Postgres connection. Needed by scripts/db-push.ts and by the enum-parity
# test, which reads pg_enum — a catalog PostgREST does not expose.
SUPABASE_DB_URL=

# Required to run the destructive RLS suite against anything other than
# localhost. Set to 1 ONLY for a disposable dev project.
SANA_ALLOW_REMOTE_TEST_DB=

# Set to 1 to make a missing database a hard failure instead of a skip, so the
# isolation proof cannot be quietly skipped. CI sets this implicitly via CI=true.
SANA_RLS_LIVE=

# Set to 1 to verify the hosted TLS certificate chain strictly in db-push.
SUPABASE_DB_SSL_STRICT=
