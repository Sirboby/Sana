# Sana Environment Variables (PRD §10.2)
# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ─────────── Application (PRD §10.2) ───────────
# Blank is treated as unset, so a defaulted variable left empty here is fine.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_RULEPACK_MIN_VERSION=
SENTRY_DSN=

# Safety-disclaimer version in force (§2.4, AC-1.2.4). Bumping this invalidates
# every existing consent and forces re-acceptance. Defaults to 1.0.0.
NEXT_PUBLIC_DISCLAIMER_VERSION=

# ─────────── Transactional email (step 5) ───────────
# Required before beta. Supabase's built-in SMTP is rate-limited and, on hosted
# projects, delivers only to project members — unusable for real signups.
# Use Resend, Postmark or SendGrid, with SPF, DKIM and DMARC on the sending
# domain, or sign-in codes will land in spam.
#
# WITHOUT THESE, account-security notices (AC-1.4.5) are captured rather than
# sent in development, and REFUSED outright in production rather than silently
# dropped — a takeover notice that was never delivered is the failure that AC
# exists to prevent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ─────────── SMS for account recovery (step 5, optional) ───────────
# Termii or Africa's Talking, NOT Twilio: Nigerian networks block A2P SMS to
# DND-registered numbers unless routed as transactional traffic through an
# approved sender ID. Recovery is optional and signup never depends on it.
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# ─────────── E2E ───────────
# A readable test inbox (Postmark/Resend test mode, or Inbucket for local
# Supabase). Specs needing delivered mail SKIP when this is absent rather than
# reporting green on a flow they never exercised.
E2E_MAILBOX_URL=
E2E_SMS_INBOX_URL=

# ─────────── Database-backed tests & migrations ───────────
# Hosted project: Project Settings -> API for URL and keys,
#                 Project Settings -> Database -> Connection string (URI) for SUPABASE_DB_URL.
# Local Supabase: run `supabase status` — needs Docker.
#
# Use a DEDICATED dev/test project. The RLS suite deletes and re-inserts rows
# with the service-role key; it must never point at a database holding real users.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Direct Postgres connection. Needed by scripts/db-push.ts and by the enum-parity
# test, which reads pg_enum — a catalog PostgREST does not expose.
SUPABASE_DB_URL=

# Required to run the destructive RLS suite against anything other than
# localhost. Set to 1 ONLY for a disposable dev project.
SANA_ALLOW_REMOTE_TEST_DB=

# Set to 1 to make a missing database a hard failure instead of a skip, so the
# isolation proof cannot be quietly skipped. CI sets this implicitly via CI=true.
SANA_RLS_LIVE=

# Set to 1 to verify the hosted TLS certificate chain strictly in db-push.
SUPABASE_DB_SSL_STRICT=
